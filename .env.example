# ---- Auth.js ----
AUTH_SECRET=                 # openssl rand -base64 32
AUTH_URL=https://your-app.vercel.app

# ---- Discord ----
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
DISCORD_BOT_TOKEN=           # bot token from https://discord.com/developers/applications
DISCORD_GUILD_ID=            # right-click your server → Copy Server ID
DISCORD_ANNOUNCE_CHANNEL_ID= # default channel (meeting/training)
DISCORD_STORY_CHANNEL_ID=    # for type=story/war
DISCORD_AIRDROP_CHANNEL_ID=  # for type=airdrop
DISCORD_ADMIN_CHANNEL_ID=    # admin notifications (new applications, leave requests)
DISCORD_PUBLIC_KEY=          # Discord App "Public Key" — for verifying interaction signatures

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
